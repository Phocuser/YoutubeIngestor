ARG BASE_IMAGE=git.internal.digitalbulletstudios.com/fleet-registry/youtubeingestor@sha256:b837481b45028ff8e929eaf2ed3640a125065ff8dbed8e9bcd8345ce72a96bc7
FROM ${BASE_IMAGE}

WORKDIR /app

ARG VCS_REF=unknown
LABEL org.opencontainers.image.revision=${VCS_REF}

# Keep the pinned runtime's installed dependencies and overlay only producer code.
COPY app/ ./app/

EXPOSE 8083

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -fsS http://localhost:8083/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8083"]
